# App
PORT=3000

# SMTP (used by nodemailer to forward the masked message)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# The address the relay mail is sent FROM (must be a mailbox you control/verified on your SMTP provider)
MAIL_FROM=relay@yourdomain.com

# The address that actually receives contact-form submissions (you)
CONTACT_RECEIVER=you@yourdomain.com
